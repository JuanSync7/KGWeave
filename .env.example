# KGWeave runtime configuration
# Copy to .env and adjust.

# Backend: networkx | neo4j
KG_BACKEND=networkx

# Runtime phase: phase_1 | phase_1b | phase_2
KG_RUNTIME_PHASE=phase_1b

# Query expansion
KG_MAX_EXPANSION_DEPTH=2
KG_MAX_EXPANSION_TERMS=20
KG_DESCRIPTION_TOKEN_BUDGET=400

# Storage path (NetworkX backend)
KG_GRAPH_PATH=./data/graph_store/.knowledge_graph.json

# Neo4j (when KG_BACKEND=neo4j)
# KG_NEO4J_URI=bolt://localhost:7687
# KG_NEO4J_USER=neo4j
# KG_NEO4J_PASSWORD=

# Phase 2: community detection
KG_ENABLE_GLOBAL_RETRIEVAL=false
KG_COMMUNITY_RESOLUTION=1.0
KG_COMMUNITY_MIN_SIZE=3
